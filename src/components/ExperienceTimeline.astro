---
import { experience } from '../data/profile';
---

<ol class="timeline">
  {
    experience.map((job) => (
      <li>
        <div class="head">
          <h4>{job.role}</h4>
          <span class="dates mono">{job.dates}</span>
        </div>
        <p class="org">{job.org}</p>
        {job.blurb && <p class="blurb" set:html={job.blurb} />}
        <ul class="bullets">
          {job.bullets.map((b) => (
            <li set:html={b} />
          ))}
        </ul>
        {job.stack && (
          <p class="stack">
            {job.stack.map((s) => (
              <span class="tag">{s}</span>
            ))}
          </p>
        )}
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    /* the pipeline rail — brand signature */
    border-left: 2px solid var(--border);
    margin-left: 0.3rem;
    max-width: 46rem;
  }
  li {
    position: relative;
    padding: 0 0 2.2rem 1.4rem;
  }
  li:last-child {
    padding-bottom: 0.5rem;
  }
  /* stage node on the rail */
  li::before {
    content: '';
    position: absolute;
    left: calc(-0.35rem - 1px);
    top: 0.45rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  li:first-child::before {
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-wash);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  h4 {
    font-size: 1rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    font-weight: 650;
  }
  .dates {
    font-size: 0.75rem;
    color: var(--ink-faint);
  }
  .org {
    color: var(--accent-deep);
    font-weight: 550;
    font-size: 0.92rem;
    margin: 0.15rem 0 0.5rem;
  }
  .blurb {
    color: var(--ink-soft);
    font-size: 0.93rem;
    margin-bottom: 0.6rem;
  }
  .bullets {
    color: var(--ink-soft);
    font-size: 0.93rem;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .bullets li {
    padding: 0;
  }
  .bullets li::before {
    content: none;
  }
  .stack {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.7rem;
  }
</style>
